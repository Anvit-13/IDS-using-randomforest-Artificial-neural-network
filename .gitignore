# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Pipeline Output Data & Logs (keep raw gitignore structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/plots/*
!data/plots/.gitkeep
models/*
!models/.gitkeep
logs/*
!logs/.gitkeep

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
